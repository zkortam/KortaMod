             FPGA_Rx_Resume();
+            /* A timer wake has no FPGA packet to resume TX for an alert, nor to
+             * re-arm the one-shot idle timer, so do both here. */
+            if (esp_sleep_get_wakeup_cause() == ESP_SLEEP_WAKEUP_TIMER) FPGA_Tx_Resume();
