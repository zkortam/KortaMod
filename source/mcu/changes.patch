@@ -66,6 +68,16 @@ void PwrMgr_Task(void *arg)
     {
         if (ulTaskNotifyTake(pdTRUE, portMAX_DELAY))
         {
+            if (KortaLink_RadioOn() || Korta_KeepAwake()) {
+                /* Stay awake, but keep stock's meaning of idle: while Menu is open the
+                 * FPGA streams status, so 100 ms of silence means it closed. */
+                if (!Korta_KeepAwake()) {
+                    Button_ResetAll();
+                    OSD_SetVisiblityState(false);
+                }
+                PwrMgr_IdleTimerPet();
+                continue;
+            }
             // Pause both tasks to ensure that they finish up any work in progress. Since the Sleep task is of higher priority,
             // the delays below are taken advantage of to permit a context switch.
             FPGA_Tx_Pause();
@@ -87,6 +99,10 @@ void PwrMgr_Task(void *arg)
             ESP_LOGD(TAG, "Sleeping");
             uart_wait_tx_done(CONFIG_ESP_CONSOLE_UART_NUM, portMAX_DELAY);
 
+            /* Wake for the next timer or alarm deadline even without FPGA traffic. */
+            const uint32_t wake_ms = Korta_WakeInMs();
+            if (wake_ms) esp_sleep_enable_timer_wakeup((uint64_t)wake_ms * 1000u);
+            else esp_sleep_disable_wakeup_source(ESP_SLEEP_WAKEUP_TIMER);
             esp_light_sleep_start();
 
             ESP_LOGD(TAG, "Awake");
@@ -96,6 +112,10 @@ void PwrMgr_Task(void *arg)
