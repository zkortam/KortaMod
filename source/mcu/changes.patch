@@ -12,6 +12,8 @@
 #include "fpga_tx.h"
 #include "freertos/FreeRTOS.h"
 #include "freertos/task.h"
+#include "kortamod_link.h"
+#include "kortamod_port.h"
 #include "osd.h"
 
