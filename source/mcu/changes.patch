+bool Battery_Read(uint8_t *percent, uint16_t *millivolts, bool *lipo, bool *charging)
+{
+    bool known = false;
+    uint8_t pct = 0;
+    uint16_t mv = 0;
+    bool is_lipo = false;
+    bool is_charging = false;
+
+    if (Mutex_Take(kMutexKey_Battery) == kMutexResult_Ok)
+    {
+        float level = _ctx.battLevel_V;
+        BatteryKind_t kind = _ctx.eBattKind;
+        known = _ctx.haveSample && level >= kLevel_MinValid_V && (unsigned)kind < kNumBatteryKind;
+        if (known)
+        {
+            const Thresholds_t *threshold = &_Thresholds[kind];
+            float span = threshold->Level_High - threshold->Level_Depleted;
+            float value = span > 0.0f ? (level - threshold->Level_Depleted) / span * 100.0f : 0.0f;
+            if (value < 0.0f) value = 0.0f;
+            if (value > 100.0f) value = 100.0f;
+            pct = (uint8_t)(value + 0.5f);
+            float volts = level * 1000.0f;
+            if (volts < 0.0f) volts = 0.0f;
+            if (volts > 65535.0f) volts = 65535.0f;
+            mv = (uint16_t)(volts + 0.5f);
+            is_lipo = kind == kBatteryKind_LiPo;
+            is_charging = is_lipo && _ctx.LiPoIsCharging == kLipoChargeStatus_Enabled;
+        }
+        (void) Mutex_Give(kMutexKey_Battery);
+    }
+
+    if (percent) *percent = pct;
+    if (millivolts) *millivolts = mv;
+    if (lipo) *lipo = is_lipo;
+    if (charging) *charging = is_charging;
+    return known;
+}
